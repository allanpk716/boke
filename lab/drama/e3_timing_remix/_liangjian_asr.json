{"bili_liangjian_ep01_g0000": [], "bili_liangjian_ep01_g0001_g0002": [], "bili_liangjian_ep01_g0016_g0017": [{"start": 34.86, "end": 36.26, "text": "兵也帮忙啊", "logprob": -0.3900178947834053}, {"start": 37.1, "end": 39.42, "text": "你个兔崽子跑不掉了", "logprob": -0.3900178947834053}, {"start": 40.42, "end": 40.9, "text": "伙子", "logprob": -0.3900178947834053}, {"start": 40.9, "end": 41.3, "text": "有", "logprob": -0.3900178947834053}, {"start": 41.3, "end": 41.7, "text": "去", "logprob": -0.3900178947834053}, {"start": 41.7, "end": 42.62, "text": "把王城柱给我加来", "logprob": -0.3900178947834053}, {"start": 42.62, "end": 43.02, "text": "是", "logprob": -0.3900178947834053}, {"start": 47.76, "end": 48.88, "text": "王城柱 听我指示", "logprob": -0.3900178947834053}, {"start": 49.12, "end": 49.56, "text": "过来", "logprob": -0.3900178947834053}, {"start": 51.24, "end": 52.96, "text": "看到山坡上的帐篷了吗", "logprob": -0.3900178947834053}, {"start": 53.84, "end": 54.88, "text": "你的炮够得着吗", "logprob": -0.3900178947834053}, {"start": 58.28, "end": 59.84, "text": "团长 距离太远", "logprob": -0.3900178947834053}], "bili_liangjian_ep01_g0019_g0020": [{"start": 0.0, "end": 0.88, "text": "败家子", "logprob": -0.43056348023141267}, {"start": 1.0, "end": 2.28, "text": "你可不省着点用", "logprob": -0.43056348023141267}, {"start": 3.56, "end": 4.48, "text": "团长", "logprob": -0.43056348023141267}, {"start": 5.0, "end": 6.68, "text": "你给那凭良心说话呀", "logprob": -0.43056348023141267}, {"start": 7.4, "end": 9.12, "text": "那刚才鬼在进宫的时候", "logprob": -0.43056348023141267}, {"start": 9.32, "end": 10.84, "text": "那数年喊得最凶了", "logprob": -0.43056348023141267}, {"start": 11.32, "end": 11.96, "text": "柱子", "logprob": -0.43056348023141267}, {"start": 12.12, "end": 13.68, "text": "把那挺猪鸡翔给我干掉", "logprob": -0.43056348023141267}, {"start": 14.24, "end": 14.84, "text": "柱子", "logprob": -0.43056348023141267}, {"start": 14.84, "end": 16.04, "text": "你他娘来瞎眼了", "logprob": -0.43056348023141267}, {"start": 16.2, "end": 17.24, "text": "把那枝掌头", "logprob": -0.43056348023141267}, {"start": 17.52, "end": 18.44, "text": "给我炸了", "logprob": -0.43056348023141267}, {"start": 19.56, "end": 21.12, "text": "这会儿您又不认账了", "logprob": -0.43056348023141267}, {"start": 21.36, "end": 22.68, "text": "倒想我浪费了", "logprob": -0.43056348023141267}, {"start": 22.76, "end": 24.24, "text": "你小子还敢发牢子", "logprob": -0.43056348023141267}, {"start": 24.92, "end": 26.16, "text": "消息我揍你", "logprob": -0.43056348023141267}, {"start": 31.57, "end": 32.53, "text": "等张大完了", "logprob": -0.43056348023141267}, {"start": 32.69, "end": 34.93, "text": "我赏给你半斤地瓜烧", "logprob": -0.3054725802664099}, {"start": 35.85, "end": 36.53, "text": "不过", "logprob": -0.3054725802664099}, {"start": 37.01, "end": 38.33, "text": "你得好好琢磨琢磨", "logprob": -0.3054725802664099}, {"start": 38.57, "end": 39.85, "text": "怎么用两发炮弹", "logprob": -0.3054725802664099}, {"start": 40.13, "end": 42.17, "text": "把敌人的指挥部给我打掉了", "logprob": -0.3054725802664099}, {"start": 43.41, "end": 44.85, "text": "我丑话说在前边", "logprob": -0.3054725802664099}, {"start": 44.97, "end": 46.09, "text": "你要是打不中", "logprob": -0.3054725802664099}, {"start": 46.37, "end": 47.65, "text": "别说地瓜烧免了", "logprob": -0.3054725802664099}, {"start": 47.73, "end": 48.69, "text": "我还得枪毙你", "logprob": -0.3054725802664099}, {"start": 48.77, "end": 49.33, "text": "听见没有", "logprob": -0.3054725802664099}, {"start": 49.41, "end": 49.81, "text": "是", "logprob": -0.3054725802664099}, {"start": 49.89, "end": 50.81, "text": "保证把枪扔任务", "logprob": -0.3054725802664099}], "bili_liangjian_ep01_g0023": [{"start": 0.75, "end": 2.75, "text": "跟这样强悍的对手交伙", "logprob": -0.23911939746271954}, {"start": 3.75, "end": 4.75, "text": "恐怕是凶多吉少吧", "logprob": -0.23911939746271954}, {"start": 5.75, "end": 6.75, "text": "对", "logprob": -0.23911939746271954}, {"start": 6.75, "end": 7.75, "text": "这可把握", "logprob": -0.23911939746271954}, {"start": 7.75, "end": 9.75, "text": "肯定是要玩", "logprob": -0.23911939746271954}, {"start": 9.75, "end": 11.75, "text": "这是时间上的问题", "logprob": -0.2391193